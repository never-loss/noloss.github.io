{
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/bybit",
      "destination": "/bybit.html"
    },
    {
      "source": "/callback",
      "destination": "/callback.html"
    },
    {
      "source": "/token",
      "destination": "/api/token"
    }
  ],
  "crons": [
    {
      "path": "/api/bybit-arm?tick=1",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/bybit-arm?tick=1",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/bybit-klines?mode=gate-backfill",
      "schedule": "30 3 * * *"
    }
  ],
  "functions": {
    "api/bybit-klines.js": {
      "maxDuration": 60
    }
  }
}
